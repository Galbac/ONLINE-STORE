# App
FASTAPI_CFG__RUN__HOST=0.0.0.0
FASTAPI_CFG__RUN__PORT=8000
FASTAPI_CFG__RUN__PRODUCTION=false
FASTAPI_CFG__NAMES__TITLE=Grocery Store API
FASTAPI_CFG__NAMES__PATH=
FASTAPI_CFG__NAMES__SLUG=grocery_store
FASTAPI_CFG__API__PREFIX=/api
FASTAPI_CFG__API__V1__PREFIX=/v1

# PostgreSQL. settings.py builds db.url from these variables.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grocery_store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional Docker secrets names for PostgreSQL user/password.
PSQL_USER_SECRET_NAME=
PSQL_PASSWORD_SECRET_NAME=

# DB pool/settings overrides for Settings.db.
FASTAPI_CFG__DB__ECHO=false
FASTAPI_CFG__DB__ECHO_POOL=false
FASTAPI_CFG__DB__MAX_OVERFLOW=10
FASTAPI_CFG__DB__POOL_SIZE=5

# AuthSettings reads these aliases directly.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=43200
AUTH_ME_CACHE_TTL_SECONDS=120
USER_ME_CACHE_TTL_SECONDS=120
USER_DELETE_REQUIRE_PASSWORD=true
USER_DELETE_ANONYMIZE=false
PROFILE_SUMMARY_CACHE_TTL_SECONDS=120
PROFILE_ADDRESSES_CACHE_TTL_SECONDS=120
USER_ADDRESSES_LIMIT=20
ADDRESS_DELETE_SOFT=true
PROFILE_ORDERS_CACHE_TTL_SECONDS=60
CART_CACHE_TTL_SECONDS=120
CATEGORIES_LIST_CACHE_TTL_SECONDS=600
CATEGORIES_TREE_CACHE_TTL_SECONDS=600
CATEGORIES_TREE_MAX_DEPTH_DEFAULT=3
CATEGORY_DETAIL_CACHE_TTL_SECONDS=600
CATEGORY_SLUG_CACHE_TTL_SECONDS=600
PRODUCTS_LIST_CACHE_TTL_SECONDS=120
PRODUCT_DETAIL_CACHE_TTL_SECONDS=180
PRODUCT_SLUG_CACHE_TTL_SECONDS=180
PRODUCT_SEARCH_CACHE_TTL_SECONDS=60
PRODUCT_SEARCH_MIN_QUERY_LENGTH=2
PRODUCT_SEARCH_MAX_QUERY_LENGTH=100
PRODUCT_POPULAR_CACHE_TTL_SECONDS=600
PRODUCT_POPULAR_DEFAULT_LIMIT=12
PRODUCT_DISCOUNTED_CACHE_TTL_SECONDS=120
PRODUCT_NEW_CACHE_TTL_SECONDS=600
PRODUCT_NEW_DEFAULT_LIMIT=12
PRODUCT_NEW_DEFAULT_DAYS=30
PRODUCT_SIMILAR_CACHE_TTL_SECONDS=600
PRODUCT_SIMILAR_DEFAULT_LIMIT=8
PRODUCTS_LIST_DEFAULT_LIMIT=24
PRODUCTS_LIST_MAX_LIMIT=100
DELIVERY_OPTIONS_CACHE_TTL_SECONDS=600
DELIVERY_CALCULATE_CACHE_TTL_SECONDS=120

# Redis.
REDIS_URL=redis://localhost:6379/0

# Password reset.
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
PASSWORD_RESET_FRONTEND_URL=https://site.ru/reset-password
PASSWORD_RESET_RATE_LIMIT_BY_LOGIN=3
PASSWORD_RESET_RATE_LIMIT_BY_IP=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_TOKEN_SECRET=change-me

# Change password.
CHANGE_PASSWORD_RATE_LIMIT_BY_USER=5
CHANGE_PASSWORD_RATE_LIMIT_BY_IP=10
CHANGE_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=3600
CHANGE_PASSWORD_FAILED_LIMIT=5
CHANGE_PASSWORD_FAILED_WINDOW_SECONDS=900
JWT_ACCESS_BLACKLIST_ENABLED=false

# Other settings groups.
FASTAPI_CFG__MIDDLEWARE__CORS_ORIGINS=["http://localhost","http://localhost:3000"]
FASTAPI_CFG__MIDDLEWARE__ALLOW_CREDENTIALS=true
FASTAPI_CFG__MIDDLEWARE__ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
FASTAPI_CFG__MIDDLEWARE__ALLOW_HEADERS=["Authorization","Content-Type","X-Telegram-Init-Data"]
FASTAPI_CFG__SMTP__HOST=
FASTAPI_CFG__SMTP__PORT=587
FASTAPI_CFG__SMTP__USER=
FASTAPI_CFG__SMTP__PASSWORD=
FASTAPI_CFG__SMTP__FROM_EMAIL=
FASTAPI_CFG__WEB__JWT_SECRET=
FASTAPI_CFG__WEB__JWT_EXPIRY_HOURS=72
FASTAPI_CFG__WEB__CABINET_BASE_URL=
# Payments
PAYMENT_PROVIDER=yookassa
PAYMENT_CURRENCY=RUB
PAYMENT_RETURN_URL=https://site.ru/payment/success
PAYMENT_FAIL_URL=https://site.ru/payment/fail
PAYMENT_WEBHOOK_URL=https://api.site.ru/api/payments/webhook
PAYMENT_PROVIDER_SHOP_ID=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_DETAIL_CACHE_TTL_SECONDS=30
PAYMENT_STATUS_SYNC_ENABLED=false
PAYMENT_CAPTURE_MODE=automatic
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_VERIFY_SIGNATURE=true
