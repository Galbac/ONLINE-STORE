# App
# Host, на котором uvicorn/FastAPI слушает входящие подключения.
FASTAPI_CFG__RUN__HOST=0.0.0.0
# Port, на котором запускается API.
FASTAPI_CFG__RUN__PORT=8000
# Флаг production-режима приложения.
FASTAPI_CFG__RUN__PRODUCTION=false
# Человекочитаемое название проекта для документации/API.
FASTAPI_CFG__NAMES__TITLE=Grocery Store API
# Дополнительный путь/namespace проекта, если нужен.
FASTAPI_CFG__NAMES__PATH=
# Slug проекта для внутренних идентификаторов.
FASTAPI_CFG__NAMES__SLUG=grocery_store
# Базовый prefix всех API endpoints.
FASTAPI_CFG__API__PREFIX=/api
# Prefix версии API v1.
FASTAPI_CFG__API__V1__PREFIX=/v1

# PostgreSQL. settings.py builds db.url from these variables.
# Host PostgreSQL.
POSTGRES_HOST=localhost
# Port PostgreSQL.
POSTGRES_PORT=5432
# Имя основной базы данных.
POSTGRES_DB=grocery_store
# Пользователь PostgreSQL.
POSTGRES_USER=postgres
# Пароль PostgreSQL. Секрет.
POSTGRES_PASSWORD=postgres

# Optional Docker secrets names for PostgreSQL user/password.
# Имя Docker secret с пользователем PostgreSQL, если используется secrets.
PSQL_USER_SECRET_NAME=
# Имя Docker secret с паролем PostgreSQL, если используется secrets.
PSQL_PASSWORD_SECRET_NAME=

# DB pool/settings overrides for Settings.db.
# Включить SQLAlchemy echo SQL-запросов для отладки.
FASTAPI_CFG__DB__ECHO=false
# Включить echo событий connection pool SQLAlchemy.
FASTAPI_CFG__DB__ECHO_POOL=false
# Максимум дополнительных соединений сверх pool_size.
FASTAPI_CFG__DB__MAX_OVERFLOW=10
# Базовый размер пула соединений PostgreSQL.
FASTAPI_CFG__DB__POOL_SIZE=5

# AuthSettings reads these aliases directly.
# Secret key для подписи JWT. Секрет, обязательно заменить.
JWT_SECRET_KEY=change-me
# Алгоритм подписи JWT.
JWT_ALGORITHM=HS256
# Время жизни пользовательского access token, минуты.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Время жизни пользовательского refresh token, минуты.
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=43200
# TTL cache ответа /auth/me.
AUTH_ME_CACHE_TTL_SECONDS=120
# TTL cache пользовательского /users/me.
USER_ME_CACHE_TTL_SECONDS=120
# Требовать пароль при удалении аккаунта пользователем.
USER_DELETE_REQUIRE_PASSWORD=true
# Анонимизировать пользователя при удалении аккаунта.
USER_DELETE_ANONYMIZE=false
# TTL cache summary профиля.
PROFILE_SUMMARY_CACHE_TTL_SECONDS=120
# TTL cache адресов профиля.
PROFILE_ADDRESSES_CACHE_TTL_SECONDS=120
# Максимальное количество адресов пользователя.
USER_ADDRESSES_LIMIT=20
# Включить soft delete для адресов.
ADDRESS_DELETE_SOFT=true
# TTL cache заказов в профиле.
PROFILE_ORDERS_CACHE_TTL_SECONDS=60
# TTL cache полной корзины.
CART_CACHE_TTL_SECONDS=120
# TTL cache списка категорий.
CATEGORIES_LIST_CACHE_TTL_SECONDS=600
# TTL cache дерева категорий.
CATEGORIES_TREE_CACHE_TTL_SECONDS=600
# Максимальная глубина дерева категорий по умолчанию.
CATEGORIES_TREE_MAX_DEPTH_DEFAULT=3
# TTL cache детальной страницы категории.
CATEGORY_DETAIL_CACHE_TTL_SECONDS=600
# TTL cache категории по slug.
CATEGORY_SLUG_CACHE_TTL_SECONDS=600
# TTL cache списка товаров.
PRODUCTS_LIST_CACHE_TTL_SECONDS=120
# TTL cache детальной страницы товара.
PRODUCT_DETAIL_CACHE_TTL_SECONDS=180
# TTL cache товара по slug.
PRODUCT_SLUG_CACHE_TTL_SECONDS=180
# TTL cache поиска товаров.
PRODUCT_SEARCH_CACHE_TTL_SECONDS=60
# Минимальная длина поискового запроса товаров.
PRODUCT_SEARCH_MIN_QUERY_LENGTH=2
# Максимальная длина поискового запроса товаров.
PRODUCT_SEARCH_MAX_QUERY_LENGTH=100
# TTL cache популярных товаров.
PRODUCT_POPULAR_CACHE_TTL_SECONDS=600
# Количество популярных товаров по умолчанию.
PRODUCT_POPULAR_DEFAULT_LIMIT=12
# TTL cache товаров со скидкой.
PRODUCT_DISCOUNTED_CACHE_TTL_SECONDS=120
# TTL cache новых товаров.
PRODUCT_NEW_CACHE_TTL_SECONDS=600
# Количество новых товаров по умолчанию.
PRODUCT_NEW_DEFAULT_LIMIT=12
# Сколько дней товар считается новым.
PRODUCT_NEW_DEFAULT_DAYS=30
# TTL cache похожих товаров.
PRODUCT_SIMILAR_CACHE_TTL_SECONDS=600
# Количество похожих товаров по умолчанию.
PRODUCT_SIMILAR_DEFAULT_LIMIT=8
# Limit по умолчанию для списка товаров.
PRODUCTS_LIST_DEFAULT_LIMIT=24
# Максимальный limit для списка товаров.
PRODUCTS_LIST_MAX_LIMIT=100
# TTL cache вариантов доставки.
DELIVERY_OPTIONS_CACHE_TTL_SECONDS=600
# TTL cache расчёта доставки.
DELIVERY_CALCULATE_CACHE_TTL_SECONDS=120
# TTL cache списка пунктов самовывоза.
DELIVERY_PICKUP_POINTS_CACHE_TTL_SECONDS=600
# TTL cache карточки пункта самовывоза.
DELIVERY_PICKUP_POINT_CACHE_TTL_SECONDS=600
# TTL cache временных слотов доставки.
DELIVERY_TIME_SLOTS_CACHE_TTL_SECONDS=120
# TTL cache активных скидок.
DISCOUNTS_ACTIVE_CACHE_TTL_SECONDS=120
# TTL cache товаров, участвующих в скидках.
DISCOUNT_PRODUCTS_CACHE_TTL_SECONDS=120
# TTL cache избранного пользователя.
FAVORITES_CACHE_TTL_SECONDS=120

# Redis.
# URL подключения к Redis.
REDIS_URL=redis://localhost:6379/0

# Password reset.
# TTL токена сброса пароля, секунды.
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
# Frontend URL страницы сброса пароля.
PASSWORD_RESET_FRONTEND_URL=https://site.ru/reset-password
# Rate limit запросов сброса пароля на логин.
PASSWORD_RESET_RATE_LIMIT_BY_LOGIN=3
# Rate limit запросов сброса пароля на IP.
PASSWORD_RESET_RATE_LIMIT_BY_IP=10
# Окно rate limit сброса пароля, секунды.
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
# Secret для токена сброса пароля. Секрет.
PASSWORD_RESET_TOKEN_SECRET=change-me

# Change password.
# Rate limit смены пароля на пользователя.
CHANGE_PASSWORD_RATE_LIMIT_BY_USER=5
# Rate limit смены пароля на IP.
CHANGE_PASSWORD_RATE_LIMIT_BY_IP=10
# Окно rate limit смены пароля, секунды.
CHANGE_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=3600
# Лимит неудачных попыток смены пароля.
CHANGE_PASSWORD_FAILED_LIMIT=5
# Окно подсчёта неудачных попыток смены пароля, секунды.
CHANGE_PASSWORD_FAILED_WINDOW_SECONDS=900
# Включить blacklist access token после смены пароля.
JWT_ACCESS_BLACKLIST_ENABLED=false

# Other settings groups.
# Разрешённые CORS origins.
FASTAPI_CFG__MIDDLEWARE__CORS_ORIGINS=["http://localhost","http://localhost:3000"]
# Разрешать credentials в CORS.
FASTAPI_CFG__MIDDLEWARE__ALLOW_CREDENTIALS=true
# Разрешённые HTTP-методы CORS.
FASTAPI_CFG__MIDDLEWARE__ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
# Разрешённые HTTP-заголовки CORS.
FASTAPI_CFG__MIDDLEWARE__ALLOW_HEADERS=["Authorization","Content-Type","X-Telegram-Init-Data"]
# SMTP host для старой группы smtp-настроек.
FASTAPI_CFG__SMTP__HOST=
# SMTP port для старой группы smtp-настроек.
FASTAPI_CFG__SMTP__PORT=587
# SMTP user для старой группы smtp-настроек.
FASTAPI_CFG__SMTP__USER=
# SMTP password для старой группы smtp-настроек. Секрет.
FASTAPI_CFG__SMTP__PASSWORD=
# Email отправителя для старой группы smtp-настроек.
FASTAPI_CFG__SMTP__FROM_EMAIL=
# JWT secret для web/cabinet интеграций, если используется.
FASTAPI_CFG__WEB__JWT_SECRET=
# Время жизни web/cabinet JWT, часы.
FASTAPI_CFG__WEB__JWT_EXPIRY_HOURS=72
# Base URL web/cabinet frontend.
FASTAPI_CFG__WEB__CABINET_BASE_URL=
# Payments
# Платёжный провайдер.
PAYMENT_PROVIDER=yookassa
# Валюта платежей.
PAYMENT_CURRENCY=RUB
# URL возврата пользователя после успешной оплаты.
PAYMENT_RETURN_URL=https://site.ru/payment/success
# URL возврата пользователя после неуспешной оплаты.
PAYMENT_FAIL_URL=https://site.ru/payment/fail
# URL webhook endpoint для платёжного провайдера.
PAYMENT_WEBHOOK_URL=https://api.site.ru/api/payments/webhook
# Shop/account id платёжного провайдера.
PAYMENT_PROVIDER_SHOP_ID=
# Secret key платёжного провайдера. Секрет.
PAYMENT_PROVIDER_SECRET_KEY=
# TTL cache деталей платежа.
PAYMENT_DETAIL_CACHE_TTL_SECONDS=30
# Включить синхронизацию статуса платежа с провайдером.
PAYMENT_STATUS_SYNC_ENABLED=false
# Режим списания платежа: automatic/manual.
PAYMENT_CAPTURE_MODE=automatic
# Secret для проверки webhook провайдера. Секрет.
PAYMENT_PROVIDER_WEBHOOK_SECRET=
# Проверять подпись webhook платежного провайдера.
PAYMENT_WEBHOOK_VERIFY_SIGNATURE=true

# App metadata / health
# Имя приложения в runtime-настройках и health/info ответах.
APP_NAME=supermarket-api
# Версия приложения для health/info ответов и диагностики.
APP_VERSION=0.1.0
# Текущее окружение приложения: development/staging/production.
APP_ENV=development
# Показывать ли APP_ENV в health response.
HEALTH_SHOW_ENVIRONMENT=false
# Timeout проверки подключения к PostgreSQL в health endpoint.
HEALTH_DB_TIMEOUT_SECONDS=3
# Требовать internal token для защищённых health endpoints.
HEALTH_PROTECT_INTERNAL_ENDPOINTS=false
# Internal token для защищённых health endpoints.
HEALTH_INTERNAL_TOKEN=
# Timeout проверки media/storage в health endpoint.
HEALTH_STORAGE_TIMEOUT_SECONDS=5
# Проверять ли запись в storage при health check.
HEALTH_STORAGE_CHECK_WRITE=false
# TTL cache для результата health check 1C.
HEALTH_1C_CACHE_TTL_SECONDS=30

# Auth / admin auth
# Включает rotation refresh token при обновлении токенов.
JWT_REFRESH_ROTATION_ENABLED=true
# Включает детект повторного использования refresh token.
JWT_REFRESH_REUSE_DETECTION_ENABLED=true
# Rate limit refresh-запросов в минуту.
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=20
# Максимум неудачных попыток входа в админку.
ADMIN_LOGIN_FAILED_LIMIT=5
# Окно подсчёта неудачных попыток входа в админку, секунды.
ADMIN_LOGIN_FAILED_WINDOW_SECONDS=900
# Время жизни access token админки, минуты.
JWT_ACCESS_EXPIRE_MINUTES=30
# Время жизни refresh token админки, дни.
JWT_REFRESH_EXPIRE_DAYS=30
# TTL cache ответа /admin/auth/me.
ADMIN_AUTH_ME_CACHE_TTL_SECONDS=120

# Admin cache TTL
# TTL cache сводки dashboard в админке.
ADMIN_DASHBOARD_CACHE_TTL_SECONDS=60
# TTL cache графиков продаж dashboard.
ADMIN_DASHBOARD_SALES_CACHE_TTL_SECONDS=300
# TTL cache low-stock блока dashboard.
ADMIN_DASHBOARD_LOW_STOCK_CACHE_TTL_SECONDS=120
# TTL cache настроек магазина в админке.
ADMIN_SETTINGS_CACHE_TTL_SECONDS=600
# TTL cache списка пользователей в админке.
ADMIN_USERS_LIST_CACHE_TTL_SECONDS=60
# TTL cache карточки пользователя в админке.
ADMIN_USERS_DETAIL_CACHE_TTL_SECONDS=60
# TTL cache списка сотрудников.
ADMIN_STAFF_LIST_CACHE_TTL_SECONDS=120
# TTL cache ролей и прав сотрудников.
ADMIN_ROLES_CACHE_TTL_SECONDS=300
# TTL cache списка категорий в админке.
ADMIN_CATEGORIES_LIST_CACHE_TTL_SECONDS=120
# TTL cache списка товаров в админке.
ADMIN_PRODUCTS_LIST_CACHE_TTL_SECONDS=60
# TTL cache карточки товара в админке.
ADMIN_PRODUCTS_DETAIL_CACHE_TTL_SECONDS=120
# TTL cache списка заказов в админке.
ADMIN_ORDERS_LIST_CACHE_TTL_SECONDS=60
# TTL cache карточки заказа в админке.
ADMIN_ORDERS_DETAIL_CACHE_TTL_SECONDS=60
# TTL cache списка скидок в админке.
ADMIN_DISCOUNTS_LIST_CACHE_TTL_SECONDS=60
# TTL cache карточки скидки в админке.
ADMIN_DISCOUNTS_DETAIL_CACHE_TTL_SECONDS=120
# TTL cache списка промокодов в админке.
ADMIN_PROMO_CODES_LIST_CACHE_TTL_SECONDS=60
# TTL cache карточки промокода в админке.
ADMIN_PROMO_CODES_DETAIL_CACHE_TTL_SECONDS=120

# Orders / cart
# TTL cache краткого summary корзины.
CART_SUMMARY_CACHE_TTL_SECONDS=120
# Префикс номера заказа.
ORDER_NUMBER_PREFIX=ORD
# Статус заказа по умолчанию при создании.
ORDER_DEFAULT_STATUS=new
# Статус заказа при онлайн-оплате до подтверждения оплаты.
ORDER_ONLINE_PAYMENT_STATUS=pending_payment
# Статусы, в которых заказ можно отменять.
ORDER_CANCEL_ALLOWED_STATUSES=new,pending_payment,confirmed,awaiting_confirmation
# Разрешает при повторе заказа добавить доступное количество, если полного остатка нет.
ORDER_REPEAT_ADD_AVAILABLE_PARTIAL_QUANTITY=true
# TTL cache списка заказов текущего пользователя.
ORDERS_MY_CACHE_TTL_SECONDS=60
# Limit по умолчанию для списка заказов текущего пользователя.
ORDERS_MY_DEFAULT_LIMIT=20
# Максимальный limit для списка заказов текущего пользователя.
ORDERS_MY_MAX_LIMIT=100
# TTL cache деталей заказа.
ORDER_DETAIL_CACHE_TTL_SECONDS=60
# TTL cache статуса заказа.
ORDER_STATUS_CACHE_TTL_SECONDS=30

# 1C integration
# Включает синхронизацию с 1C.
ONE_C_SYNC_ENABLED=true
# Базовый URL API 1C.
ONE_C_API_URL=
# Bearer token для обмена с 1C. Секрет.
ONE_C_API_TOKEN=
# TTL Redis lock для ручных и фоновых sync jobs 1C.
ONE_C_SYNC_LOCK_TTL_SECONDS=1800
# Максимальный размер batch при inbound import из 1C.
ONE_C_IMPORT_MAX_BATCH_SIZE=1000
# Timeout health check 1C, секунды.
ONE_C_HEALTH_TIMEOUT_SECONDS=5
# Автоматически менять доступность товара по остатку из 1C.
AUTO_AVAILABILITY_FROM_STOCK=true
# Разрешает импорт изображений товаров из 1C.
ONE_C_IMPORT_IMAGES_ENABLED=true
# Скачивать изображения из 1C в локальный/external storage вместо хранения внешней ссылки.
ONE_C_DOWNLOAD_IMAGES=false
# Источник изображений товаров по умолчанию.
PRODUCT_IMAGES_SOURCE=1c
# Default limit заказов, которые 1C забирает как pending.
ONE_C_ORDERS_PENDING_DEFAULT_LIMIT=50
# Максимальный limit заказов, которые 1C забирает как pending.
ONE_C_ORDERS_PENDING_MAX_LIMIT=200
# Требовать external_1c_id при подтверждении синхронизации заказа со стороны 1C.
ONE_C_EXTERNAL_ORDER_ID_REQUIRED=true

# Payments extra
# Включает автоматические возвраты платежей.
AUTO_REFUND_ENABLED=false

# Admin delivery
# TTL cache настроек доставки в админке.
ADMIN_DELIVERY_SETTINGS_CACHE_TTL_SECONDS=600
# TTL cache зон доставки в админке.
ADMIN_DELIVERY_ZONES_CACHE_TTL_SECONDS=300
# TTL cache пунктов самовывоза в админке.
ADMIN_DELIVERY_PICKUP_POINTS_CACHE_TTL_SECONDS=300
# Список поддерживаемых валют для цен, доставки и интеграций.
SUPPORTED_CURRENCIES=RUB

# Products extra
# Требовать целочисленный остаток для штучных товаров.
PRODUCT_PIECE_STOCK_INTEGER_REQUIRED=true

# Notifications
# TTL cache списка уведомлений.
NOTIFICATIONS_CACHE_TTL_SECONDS=60
# Limit по умолчанию для списка уведомлений.
NOTIFICATIONS_DEFAULT_LIMIT=20
# Максимальный limit для списка уведомлений.
NOTIFICATIONS_MAX_LIMIT=100

# Email notifications
# Включает email-уведомления.
EMAIL_ENABLED=false
# SMTP host.
EMAIL_HOST=
# SMTP port.
EMAIL_PORT=587
# SMTP username.
EMAIL_USERNAME=
# SMTP password. Секрет.
EMAIL_PASSWORD=
# Email отправителя.
EMAIL_FROM=
# Использовать TLS для SMTP.
EMAIL_USE_TLS=true

# Telegram notifications
# Включает Telegram-уведомления.
TELEGRAM_ENABLED=false
# Token Telegram bot. Секрет.
TELEGRAM_BOT_TOKEN=
# Chat ID админского Telegram-чата.
TELEGRAM_ADMIN_CHAT_ID=

# Media / storage
# Тип хранилища медиафайлов: local или external.
MEDIA_STORAGE=local
# Локальная директория хранения медиафайлов.
MEDIA_ROOT=/app/media
# URL-префикс для доступа к медиафайлам.
MEDIA_URL=/media
# Максимальный размер изображения, МБ.
MEDIA_MAX_IMAGE_SIZE_MB=5
# Разрешённые MIME-типы изображений.
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# Разрешённые расширения изображений.
MEDIA_ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
# Публичный base URL для медиафайлов, если нужен внешний домен/CDN.
MEDIA_BASE_URL=
# Access key внешнего object storage. Секрет.
STORAGE_ACCESS_KEY=
# Secret key внешнего object storage. Секрет.
STORAGE_SECRET_KEY=
# Bucket внешнего object storage.
STORAGE_BUCKET=
# Region внешнего object storage.
STORAGE_REGION=
# TTL cache деталей upload.
UPLOAD_DETAIL_CACHE_TTL_SECONDS=300
