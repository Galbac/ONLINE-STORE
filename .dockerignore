# Version control
.git/
.gitignore

# Virtual environment & dependencies
.venv/
env/
venv/
ENV/
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
*$py.class

# Testing, typing & linters cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDEs & OS artifacts
.idea/
.vscode/
.gemini/
.DS_Store
.DS_Store?
._*
Thumbs.db

# Secrets & Environment
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.crt

# Persistent data, media & backups (should NOT be baked into image layers)
media/
backups/
